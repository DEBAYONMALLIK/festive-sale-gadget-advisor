# Copy to .env for local runs. On the deployed backend these live in the host's
# secret store (Hugging Face: Space settings -> Variables and secrets), never in git.

# ---- required ----
OPENAI_API_KEY=sk-...          # every agent, including the browser price agents
TAVILY_API_KEY=tvly-...        # web scout + candidate filter

# ---- models (optional) ----
FAST_MODEL=gpt-5-mini          # scouts, filter, deep dives, intent parsing
SMART_MODEL=gpt-5              # reviewer + final writer
BROWSER_MODEL=gpt-5-mini       # browser-use price agents

# ---- cost guards (optional) ----
MAX_RUNS_PER_DAY=40
MAX_PRICE_CHECKS_PER_DAY=120
MAX_FINALISTS=4
MAX_REVIEW_LOOPS=2
CACHE_DAYS=30

# ---- live price behaviour (optional) ----
PRICE_MODE=lowest              # "lowest" = read every variant, "fast" = default variant only
PRICE_CONCURRENCY=2            # Chrome instances at once; each needs roughly 500 MB
PRICE_TIMEOUT=240
PINCODE=                       # delivery pincode used for stock checks
BUDGET_TOLERANCE=1.05

# ---- anti-captcha (optional, recommended in production) ----
# Datacenter IPs get far more captchas from Amazon and Flipkart than residential ones.
PRICE_PROXY_SERVER=
PRICE_PROXY_USERNAME=
PRICE_PROXY_PASSWORD=
RESEARCH_PROXY=                # HTTP(S) proxy for the Reddit and YouTube MCP servers

# ---- sale dates shown in the UI (optional) ----
AMAZON_SALE_START=2026-10-08
FLIPKART_SALE_START=2026-10-09

# ---- set by the Dockerfile, override only for local runs ----
# PRICE_WORKER_PYTHON=/opt/price-env/bin/python
# PRICE_CHROME_PATH=/usr/bin/google-chrome-stable
# PRICE_HEADLESS=0
# PRICE_NO_SANDBOX=1
# DATA_DIR=/data
